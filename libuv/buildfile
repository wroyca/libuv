tclass = $c.target.class
tsys   = $c.target.system

linux   = ($tclass == 'linux')
macos   = ($tclass == 'macos')
bsd     = ($tclass == 'bsd')
windows = ($tclass == 'windows')

freebsd = ($tsys == 'freebsd')
netbsd  = ($tsys == 'netbsd')
openbsd = ($tsys == 'openbsd')

# Note that the source file sets mirror the uv_sources variable in
# upstream's CMakeLists.txt.
#
lib{uv}: include/h{**} src/{h c}{*}

lib{uv}: src/win/{h c}{*}: include = $windows

lib{uv}: src/unix/h{internal}: include = (!$windows)
lib{uv}: src/unix/c{async core dl fs getaddrinfo getnameinfo loop-watcher  \
                    loop pipe poll process random-devurandom signal stream \
                    tcp thread tty udp}: include = (!$windows)

lib{uv}: src/unix/c{linux procfs-exepath random-getrandom \
                    random-sysctl-linux}: include = $linux

lib{uv}: src/unix/c{proctitle}: include = ($linux || $macos)

lib{uv}: src/unix/h{darwin-stub darwin-syscalls}:      include = $macos
lib{uv}: src/unix/c{darwin darwin-proctitle fsevents}: include = $macos

lib{uv}: src/unix/c{bsd-ifaddrs kqueue}:         include = ($macos || $bsd)
lib{uv}: src/unix/c{bsd-proctitle posix-hrtime}: include = $bsd

lib{uv}: src/unix/c{random-getentropy}: include = ($macos || $openbsd)
lib{uv}: src/unix/c{random-getrandom}:  include = $freebsd

lib{uv}: src/unix/c{freebsd}: include = $freebsd
lib{uv}: src/unix/c{netbsd}:  include = $netbsd
lib{uv}: src/unix/c{openbsd}: include = $openbsd

# Build options.
#
c.poptions =+ "-I$src_base/include" "-I$src_base/src"

objs{*}: c.poptions += -DBUILDING_UV_SHARED=1

if $windows
  c.poptions += -DWIN32_LEAN_AND_MEAN -D_WIN32_WINNT=0x0A00 \
                -D_CRT_DECLARE_NONSTDC_NAMES=0
else
  c.poptions += -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE

if $linux
  c.poptions += -D_GNU_SOURCE -D_POSIX_C_SOURCE=200112

if $macos
  c.poptions += -D_DARWIN_UNLIMITED_SELECT=1 -D_DARWIN_USE_64_BIT_INODE=1

switch $tclass, $tsys
{
  case 'linux'
    c.libs += -pthread -ldl -lrt -lm

  case 'bsd', 'netbsd'
    c.libs += -pthread -lm -lkvm

  case 'macos' | 'bsd'
    c.libs += -pthread -lm

  case 'windows', 'mingw32'
    c.libs += -lpsapi -luser32 -ladvapi32 -liphlpapi -luserenv -lws2_32 \
              -ldbghelp -lole32 -lshell32 -lsynchronization

  case 'windows'
    c.libs += psapi.lib user32.lib advapi32.lib iphlpapi.lib userenv.lib \
              ws2_32.lib dbghelp.lib ole32.lib shell32.lib synchronization.lib
}

# Export options.
#
lib{uv}:  c.export.poptions  = "-I$src_base/include"
libs{uv}: c.export.poptions += -DUSING_UV_SHARED=1

# Install only the public headers.
#
h{*}: install = false

include/h{*}:
{
  install         = include/
  install.subdirs = true
}
